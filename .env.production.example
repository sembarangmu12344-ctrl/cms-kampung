# ================================================
# Isi ini di Vercel Dashboard → Settings → Environment Variables
# JANGAN upload file ini ke GitHub!
# ================================================

# Dari Supabase → Connect → Transaction pooler
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Ganti dengan string random yang PANJANG (min 32 karakter)
# Generate di: https://generate-secret.vercel.app/32
JWT_SECRET="ganti-dengan-string-random-panjang-minimal-32-karakter"
JWT_EXPIRES_IN="7d"

# URL website kamu di Vercel (isi setelah deploy pertama)
NEXT_PUBLIC_APP_URL="https://cms-kampung-kamu.vercel.app"
NEXT_PUBLIC_APP_NAME="CMS Kampung"

# Upload (opsional - pakai Cloudinary supaya foto tidak hilang)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_MAX_SIZE_MB="10"
