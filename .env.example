# ================================================
# DATABASE
# ================================================
# Untuk lokal development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/cms_kampung"
# Untuk Supabase (production gratis):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# ================================================
# AUTH
# ================================================
JWT_SECRET="ganti-dengan-string-random-minimal-32-karakter-abc123"
JWT_EXPIRES_IN="7d"

# ================================================
# APP
# ================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CMS Kampung"

# ================================================
# UPLOAD - Cloudinary (opsional, gratis 25GB)
# Daftar di: https://cloudinary.com
# ================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ================================================
# UPLOAD - Local Storage (default untuk development)
# ================================================
UPLOAD_MAX_SIZE_MB="5"
